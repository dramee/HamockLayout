<?xml version="1.0" encoding="UTF-8"?>
<!-- Алгоритм Евклида вычитанием: while (b != 0) if (a > b) a -= b; else b -= a; -->
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="role" for="node" attr.name="role" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <node id="entry"><data key="role">entry</data></node>
    <node id="read a, b"/>
    <node id="b != 0 ?"/>
    <node id="a &gt; b ?"/>
    <node id="a = a - b"/>
    <node id="endif"/>
    <node id="return a"/>
    <node id="exit"><data key="role">exit</data></node>
    <node id="b = b - a"/>
    <edge source="entry" target="read a, b"/>
    <edge source="read a, b" target="b != 0 ?"/>
    <edge source="b != 0 ?" target="a &gt; b ?"/>
    <edge source="a &gt; b ?" target="a = a - b"/>
    <edge source="a = a - b" target="endif"/>
    <edge source="endif" target="b != 0 ?"/>
    <edge source="b != 0 ?" target="return a"/>
    <edge source="return a" target="exit"/>
    <edge source="a &gt; b ?" target="b = b - a"/>
    <edge source="b = b - a" target="endif"/>
  </graph>
</graphml>
